[mysqld]
# The application also sets this per connection; setting it server-wide means
# ad-hoc sessions (and anything else) see the same semantics.
transaction_isolation = READ-COMMITTED

# Hikari holds a fixed pool (30 by default); leave headroom for exporters and humans.
max_connections = 300

# Durable commits: a confirmed seat survives a crash.
innodb_flush_log_at_trx_commit = 1
innodb_redo_log_capacity = 1G

# Lock waits in this app are milliseconds. Anything near 10s means something is
# wrong, and the app retries rather than hanging.
innodb_lock_wait_timeout = 10

# Single node, no replicas: the binlog would only add a second fsync per commit.
# A real deployment with replicas or point-in-time recovery keeps it on.
disable_log_bin

default_time_zone = '+00:00'
skip_name_resolve = ON
character_set_server = utf8mb4

# Sized for a laptop. The production override raises this (see deploy/).
innodb_buffer_pool_size = 512M

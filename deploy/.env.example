# Copy to /opt/seats/.env on the VM and fill in. Never commit the real file.

# Public hostname (Cloudflare DNS-only A record -> the VM's public IP)
DOMAIN=seats.amogh.cloud

# Image CI pushes; deploy.sh updates APP_TAG to the commit sha it's rolling out
APP_IMAGE=ghcr.io/the-darkmatter/seat-reservation
APP_TAG=latest

# Only Caddy is public; the API listens on localhost for health checks from the box
APP_PORT=127.0.0.1:8080

DB_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-too
MYSQL_BUFFER_POOL=6G
DB_POOL_SIZE=40

# openssl rand -base64 48
JWT_SECRET=change-me-to-48-random-bytes
# Shared with reviewers in the README so they can create shows for their own tests
ADMIN_SECRET=demo-admin-secret

# Grafana Cloud > your stack > Details (Prometheus / Loki "send" endpoints) and an
# access policy token with metrics:write and logs:write.
GRAFANA_CLOUD_PROM_URL=https://prometheus-prod-XX-prod-ap-south-1.grafana.net/api/prom/push
GRAFANA_CLOUD_PROM_USER=000000
GRAFANA_CLOUD_LOKI_URL=https://logs-prod-XXX.grafana.net/loki/api/v1/push
GRAFANA_CLOUD_LOKI_USER=000000
GRAFANA_CLOUD_API_KEY=glc_...
INSTANCE_NAME=oracle-a1
